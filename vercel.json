{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=()" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/pi-complete",
      "destination": "/api/pi-approve?piAction=complete"
    },
    {
      "source": "/api/stellar-ownership",
      "destination": "/api/create-event-checkout?havkarAction=ownership"
    },
    {
      "source": "/api/support-request",
      "destination": "/api/business-application-notify?havkarAction=support"
    },
    {
      "source": "/api/create-ad-boost-checkout",
      "destination": "/api/create-event-checkout?havkarAction=adBoost"
    },
    {
      "source": "/api/payment-activation-status",
      "destination": "/api/create-event-checkout?havkarAction=paymentStatus"
    },
    {
      "source": "/api/ad-boost-webhook",
      "destination": "/api/stripe-webhook"
    }
  ]
}
