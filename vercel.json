{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=()" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(index|events|about|admin|profile|support|staff|ai|chat|product|checkout-currency)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/havkar-emoji-catalog.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "havkar-app.vercel.app" }],
      "destination": "https://havkar.online/:path*",
      "permanent": true
    },
    {
      "source": "/ai",
      "destination": "/havkar-ai.html",
      "permanent": false
    },
    {
      "source": "/ai.html",
      "destination": "/havkar-ai.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/pi-complete",
      "destination": "/api/pi-approve?piAction=complete"
    },
    {
      "source": "/api/stellar-ownership",
      "destination": "/api/create-event-checkout?havkarAction=ownership"
    },
    {
      "source": "/api/stellar-mainnet-ownership",
      "destination": "/api/create-event-checkout?havkarAction=mainnetOwnership"
    },
    {
      "source": "/api/support-request",
      "destination": "/api/business-application-notify?havkarAction=support"
    },
    {
      "source": "/api/create-ad-boost-checkout",
      "destination": "/api/create-event-checkout?havkarAction=adBoost"
    },
    {
      "source": "/api/payment-activation-status",
      "destination": "/api/create-event-checkout?havkarAction=paymentStatus"
    },
    {
      "source": "/api/stripe-sandbox-payout-e2e",
      "destination": "/api/create-event-checkout?havkarAction=stripeSandboxPayoutE2e"
    },
    {
      "source": "/api/xlm-invoice",
      "destination": "/api/create-event-checkout?havkarAction=xlmInvoice"
    },
    {
      "source": "/api/owner-eur1-checkout",
      "destination": "/api/create-event-checkout?havkarAction=ownerEur1"
    },
    {
      "source": "/api/finance",
      "destination": "/api/create-event-checkout?havkarAction=finance"
    },
    {
      "source": "/api/chat-notify",
      "destination": "/api/create-event-checkout?havkarAction=chatNotify"
    },
    {
      "source": "/api/currency-matrix",
      "destination": "/api/create-event-checkout?havkarAction=currencyMatrix"
    },
    {
      "source": "/api/ad-boost-webhook",
      "destination": "/api/stripe-webhook"
    }
  ]
}
