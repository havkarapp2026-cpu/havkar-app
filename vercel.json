{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=()"
        }
      ]
    },
    {
      "source": "/havkar-ai.html",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self)"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(index|events|tickets|travel-share|about|admin|profile|support|staff|ai|havkar-ai|chat|product|checkout-currency|ad-details|buy-sell|jobs|services|wallet|accommodation|ads|delivery|transport|language|reviews|login|signup|history|market|trade|notifications|verification-review|finance|post-ad|search|saved|privacy|terms|alerts)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/havkar-emoji-catalog.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "havkar-app.vercel.app"
        }
      ],
      "destination": "https://havkar.online/:path*",
      "permanent": true
    },
    {
      "source": "/ai",
      "destination": "/havkar-ai.html",
      "permanent": false
    },
    {
      "source": "/ai.html",
      "destination": "/havkar-ai.html",
      "permanent": false
    },
    {
      "source": "/settings",
      "destination": "/profile.html",
      "permanent": false
    },
    {
      "source": "/settings.html",
      "destination": "/profile.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/pi-complete",
      "destination": "/api/pi-approve?piAction=complete"
    },
    {
      "source": "/api/stellar-ownership",
      "destination": "/api/create-event-checkout?havkarAction=ownership"
    },
    {
      "source": "/api/stellar-mainnet-ownership",
      "destination": "/api/create-event-checkout?havkarAction=mainnetOwnership"
    },
    {
      "source": "/api/support-request",
      "destination": "/api/business-application-notify?havkarAction=support"
    },
    {
      "source": "/api/create-ad-boost-checkout",
      "destination": "/api/create-event-checkout?havkarAction=adBoost"
    },
    {
      "source": "/api/payment-activation-status",
      "destination": "/api/create-event-checkout?havkarAction=paymentStatus"
    },
    {
      "source": "/api/payment-status",
      "destination": "/api/create-event-checkout?havkarAction=paymentStatus"
    },
    {
      "source": "/api/stripe-sandbox-payout-e2e",
      "destination": "/api/create-event-checkout?havkarAction=stripeSandboxPayoutE2e"
    },
    {
