    },
    {
      "source": "/api/currency-matrix",
      "destination": "/api/create-event-checkout?havkarAction=currencyMatrix"
    },
    {
      "source": "/api/travel-life",
      "destination": "/api/create-event-checkout?havkarAction=travelLife"
    },
    {
      "source": "/api/global-payments",
      "destination": "/api/create-event-checkout?havkarAction=globalPayments"
    },
    {
      "source": "/api/hotels",
      "destination": "/api/create-event-checkout?havkarAction=hotels"
    },
    {
